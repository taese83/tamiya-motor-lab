{
  "name": "minicar-motor-lab",
  "version": "2.42.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.22.3 <23",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --mode production",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "version:patch": "pnpm version patch",
    "version:minor": "pnpm version minor",
    "version:major": "pnpm version major",
    "release": "pnpm version patch && git push origin main --follow-tags",
    "release:minor": "pnpm version minor && git push origin main --follow-tags"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@fontsource-variable/oxanium": "5.3.0",
    "@mui/material": "7.3.0",
    "@mui/x-charts": "9.10.1",
    "@neondatabase/serverless": "^1.1.0",
    "@tanstack/react-query": "5.90.1",
    "idb": "8.0.0",
    "jose": "^6.2.4",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-error-boundary": "6.0.0",
    "react-router": "8.2.0",
    "zod": "4.3.0",
    "zustand": "5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.19.21",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "6.0.3",
    "@vitest/coverage-v8": "4.1.0",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.0.1",
    "fake-indexeddb": "6.0.0",
    "globals": "16.5.0",
    "jsdom": "29.0.0",
    "prettier": "3.8.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.57.0",
    "vite": "8.1.4",
    "vite-plugin-svgr": "4.5.0",
    "vitest": "4.1.0"
  }
}
